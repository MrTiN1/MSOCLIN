# PostgreSQL 15+ with the btree_gist extension. Keep production and test URLs separate.
DATABASE_URL="postgresql://mos:CHANGE_ME@localhost:5432/mos"
TEST_DATABASE_URL="postgresql://mos:CHANGE_ME@localhost:5432/mos_test"
POSTGRES_PASSWORD="CHANGE_ME"
# Canonical origin, required in production (without a trailing slash).
APP_URL="http://localhost:3000"
# Generate using: openssl rand -hex 48
AUTH_SECRET=""
# Enable only behind a proxy which overwrites x-forwarded-for, e.g. Vercel.
TRUST_PROXY="false"
# Leave false for real operations. Verify and enable real teams in CRM.
LOCAL_DEMO_SCHEDULE="false"
# One-off admin initialization; do not set a default password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional notifications. Fill in authorized service chat/user IDs only.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ADMIN_IDS=""
TELEGRAM_WEBHOOK_SECRET=""
# Protected notification retry job (Bearer authentication).
CRON_SECRET=""
# Optional durable public photo storage. Uploaded metadata is stripped.
BLOB_READ_WRITE_TOKEN=""
# Optional analytics. No personal data or session recordings are sent.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
# Local tests. On other machines omit CHROMIUM_PATH to use installed Playwright Chromium.
CHROMIUM_PATH="/usr/bin/chromium"
E2E_BASE_URL="http://localhost:3000"
